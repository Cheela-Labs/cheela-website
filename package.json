{
  "name": "@cheela/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:blog": "node scripts/sync-blog-media.mjs",
    "dev": "pnpm sync:blog && next dev",
    "build": "pnpm sync:blog && next build",
    "start": "next start",
    "dev:sites": "pnpm sync:blog && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "pnpm sync:blog && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "marked": "^18.0.7",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "babel-plugin-react-compiler": "1.0.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
